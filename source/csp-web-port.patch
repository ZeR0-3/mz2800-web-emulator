+	void draw_rectangle_to_bitmap(bitmap_t *, int, int, int, int, uint8_t, uint8_t, uint8_t) {}
+	void draw_point_to_bitmap(bitmap_t *, int, int, uint8_t, uint8_t, uint8_t) {}
+	void stretch_bitmap(bitmap_t *, int, int, int, int, bitmap_t *, int, int, int, int) {}
+	void write_bitmap_to_file(bitmap_t *, const _TCHAR *) {}
+
+	// ---- debugger hooks / movie / capture / midi / socket: unsupported ----
+	void start_waiting_in_debugger() {}
+	void finish_waiting_in_debugger() {}
+	void process_waiting_in_debugger() {}
