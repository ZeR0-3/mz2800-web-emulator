+	void add_feature(const _TCHAR *key, uint32_t value) { add_feature(key, (uint64_t)value); }
+	void add_feature(const _TCHAR *key, uint16_t value) { add_feature(key, (uint64_t)value); }
+	void add_feature(const _TCHAR *key, uint8_t value) { add_feature(key, (uint64_t)value); }
+	bool check_feature(const _TCHAR *key);
+	double get_feature_double_value(const _TCHAR *key);
+	int64_t get_feature_int64_value(const _TCHAR *key);
+	int get_feature_int_value(const _TCHAR *key) { return (int)get_feature_int64_value(key); }
+	int32_t get_feature_int32_value(const _TCHAR *key) { return (int32_t)get_feature_int64_value(key); }
+	int16_t get_feature_int16_value(const _TCHAR *key) { return (int16_t)get_feature_int64_value(key); }
+	int8_t get_feature_int8_value(const _TCHAR *key) { return (int8_t)get_feature_int64_value(key); }
+	uint64_t get_feature_uint64_value(const _TCHAR *key);
+	uint32_t get_feature_uint32_value(const _TCHAR *key) { return (uint32_t)get_feature_uint64_value(key); }
+	uint16_t get_feature_uint16_value(const _TCHAR *key) { return (uint16_t)get_feature_uint64_value(key); }
+	uint8_t get_feature_uint8_value(const _TCHAR *key) { return (uint8_t)get_feature_uint64_value(key); }
