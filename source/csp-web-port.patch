+/*
+	Web (Emscripten) port of CSP — OSD layer.
+
+	Replaces the Qt/Win32 OSD with a minimal one that talks to JavaScript through
+	plain exported C functions (see sdl/web_main.cpp).
+	GPL, same as Common Source Code Project.
+*/
+#ifndef _WEB_OSD_H_
