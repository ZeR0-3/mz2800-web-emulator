+/* SPDX-License-Identifier: GPL-2.0-only
+   Copyright (C) 2026 ZeR0-3
+   This file is part of the MZ-2800 Web Emulator, free software under the GNU GPL version 2 (see LICENSE). */
+/*
+	Web (Emscripten) port of CSP — JavaScript-facing API.
+	GPL, same as Common Source Code Project.
+
+	JS drives everything: it writes ROMs/disk images into the virtual file system,
+	calls web_init(), then calls web_step() paced against the audio clock and
+	web_draw() once per display frame.
+*/
+#include <emscripten.h>
+#include "../emu.h"
+#include "../fifo.h"
+#include "osd.h"
+#include "../vm/device.h"
+
+// global configuration used by the VM (declared extern in config.h)
+config_t config;
+
+// The interactive CPU debugger console is not part of the web build.
+#ifdef USE_DEBUGGER
+void EMU::initialize_debugger() {}
+void EMU::release_debugger() {}
+void EMU::open_debugger(int cpu_index) {}
+void EMU::close_debugger(int cpu_index) {}
+bool EMU::is_debugger_enabled(int cpu_index) { return false; }
+#endif
+
+static EMU *g_emu = NULL;
+static OSD_BASE *g_osd = NULL;
+static std::vector<uint8_t> g_rgba;
+
+extern "C" {
+
+// Returns 0 on success.
+EMSCRIPTEN_KEEPALIVE int web_init()
+{
+	if(g_emu != NULL) return 0;
+	initialize_config();
+	config.sound_frequency = 6;      // 48 kHz
+	config.sound_latency = 1;
+	for(int i = 0; i < 4; i++) {
+		config.sound_volume_l[i] = config.sound_volume_r[i] = 0;
+	}
+	g_emu = new EMU();
+	g_osd = g_emu->get_osd();
+	return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void web_reset()          { if(g_emu) g_emu->reset(); }
+EMSCRIPTEN_KEEPALIVE int  web_sound_rate()     { return g_osd ? g_osd->sound_rate : 48000; }
+EMSCRIPTEN_KEEPALIVE int  web_sound_chunk()    { return g_osd ? g_osd->sound_samples : 1024; }
+EMSCRIPTEN_KEEPALIVE double web_frame_rate()   { return (g_emu && g_emu->get_vm()) ? g_emu->get_vm()->get_frame_rate() : FRAMES_PER_SEC; }
+
+// Run the VM long enough to produce one chunk of audio. Returns the number of stereo sample frames.
+EMSCRIPTEN_KEEPALIVE int web_step()
+{
+	if(!g_emu) return 0;
+	g_emu->run();
+	return g_osd->sound_out_frames;
+}
+EMSCRIPTEN_KEEPALIVE const int16_t *web_audio_ptr() { return g_osd ? &g_osd->sound_out[0] : NULL; }
+
+// Render the VM screen into an RGBA buffer.
+EMSCRIPTEN_KEEPALIVE void web_draw()
+{
+	if(!g_emu) return;
+	g_emu->draw_screen();
+	int w = g_osd->vm_screen_width, h = g_osd->vm_screen_height;
+	g_rgba.resize((size_t)w * h * 4);
+	const uint32_t *src = (const uint32_t *)&g_osd->screen_pixels[0];
+	uint32_t *dst = (uint32_t *)&g_rgba[0];
+	for(int i = 0; i < w * h; i++) {
+		dst[i] = src[i] | 0xff000000;   // RGB_COLOR is already R,G,B byte order on little-endian
+	}
+}
+EMSCRIPTEN_KEEPALIVE const uint8_t *web_screen_ptr() { return g_rgba.empty() ? NULL : &g_rgba[0]; }
+EMSCRIPTEN_KEEPALIVE int web_screen_w()        { return g_osd ? g_osd->vm_screen_width : 0; }
+EMSCRIPTEN_KEEPALIVE int web_screen_h()        { return g_osd ? g_osd->vm_screen_height : 0; }
+EMSCRIPTEN_KEEPALIVE int web_aspect_w()        { return g_osd ? g_osd->vm_window_width_aspect : 0; }
+EMSCRIPTEN_KEEPALIVE int web_aspect_h()        { return g_osd ? g_osd->vm_window_height_aspect : 0; }
+
+// Windows virtual-key codes (left/right variants for Shift/Ctrl/Alt).
+EMSCRIPTEN_KEEPALIVE void web_key(int vk, int down, int repeat)
+{
+	if(!g_emu) return;
+	if(down) g_emu->key_down(vk, false, repeat != 0);
+	else     g_emu->key_up(vk, false);
+}
+EMSCRIPTEN_KEEPALIVE void web_key_release_all() { if(g_osd) g_osd->key_lost_focus(); }
+
+// Relative mouse movement and button mask (bit0 = left, bit1 = right).
+EMSCRIPTEN_KEEPALIVE void web_mouse(int dx, int dy, int buttons)
+{
+	if(!g_osd) return;
+	g_osd->mouse_acc[0] += dx;
+	g_osd->mouse_acc[1] += dy;
+	g_osd->mouse_status[2] = buttons;
+}
+
+// Typed text through the emulator's auto-key feature ("\n" = Enter).
+EMSCRIPTEN_KEEPALIVE void web_type_text(const char *text)
+{
+#ifdef USE_AUTO_KEY
+	if(!g_emu || !text) return;
+	g_emu->set_auto_key_list((char *)text, (int)strlen(text));
+	g_emu->start_auto_key();
+#endif
+}
+
+EMSCRIPTEN_KEEPALIVE int web_open_fd(int drv, const char *path)
+{
+	if(!g_emu) return -1;
+	g_emu->open_floppy_disk(drv, path, 0);
+	return 0;
+}
+EMSCRIPTEN_KEEPALIVE void web_close_fd(int drv)  { if(g_emu) g_emu->close_floppy_disk(drv); }
+// Write a floppy image back to its file without ejecting it (CSP normally does this only on eject).
+EMSCRIPTEN_KEEPALIVE void web_sync_fd(int drv)   { if(g_emu && g_emu->get_vm()) g_emu->get_vm()->sync_floppy_disk(drv); }
+EMSCRIPTEN_KEEPALIVE int web_open_hd(int drv, const char *path)
+{
+	if(!g_emu) return -1;
+	g_emu->open_hard_disk(drv, path);
+	return 0;
+}
+EMSCRIPTEN_KEEPALIVE void web_close_hd(int drv)  { if(g_emu) g_emu->close_hard_disk(drv); }
+EMSCRIPTEN_KEEPALIVE int web_fd_inserted(int drv){ return g_emu ? g_emu->is_floppy_disk_inserted(drv) : 0; }
+EMSCRIPTEN_KEEPALIVE int web_fd_accessed()       { return g_emu ? (int)g_emu->is_floppy_disk_accessed() : 0; }
+EMSCRIPTEN_KEEPALIVE int web_hd_accessed()       { return g_emu ? (int)g_emu->is_hard_disk_accessed() : 0; }
+
+// ROM presence check, so the page can tell the user what is missing.
+EMSCRIPTEN_KEEPALIVE int web_have_file(const char *path) { return FILEIO::IsFileExisting(path) ? 1 : 0; }
+
+// Debug helpers (also used by tests).
+EMSCRIPTEN_KEEPALIVE unsigned web_cpu_pc()        { return (g_emu && g_emu->get_vm() && g_emu->get_vm()->get_cpu(0)) ? g_emu->get_vm()->get_cpu(0)->get_pc() : 0; }
+EMSCRIPTEN_KEEPALIVE int web_read8(unsigned addr)  { return (g_emu && g_emu->get_vm()) ? g_emu->get_vm()->get_cpu(0)->read_debug_data8(addr) : -1; }
+
+EMSCRIPTEN_KEEPALIVE void web_out8(unsigned port, unsigned val) { if(g_emu && g_emu->get_vm()) g_emu->get_vm()->get_cpu(0)->write_debug_io8(port, val); }
+
+}  // extern "C"
+
+int main()
+{
+	// Everything is driven from JS; the runtime stays alive.
+	return 0;
+}
