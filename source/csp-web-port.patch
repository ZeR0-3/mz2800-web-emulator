+// ---------------------------------------------------------------- life cycle
+void OSD_BASE::initialize(int rate, int samples, int *presented_rate, int *presented_samples)
+{
+	// The VM is driven in small chunks so JS can pace it against the audio clock.
+	sound_rate = rate;
+	sound_samples = 1024;
+	*presented_rate = sound_rate;
+	*presented_samples = sound_samples;
+	sound_out.assign(sound_samples * 2, 0);
+	sound_out_frames = 0;
+}
+
+void OSD_BASE::release()
+{
+}
+
+void OSD_BASE::initialize_sound(int rate, int samples, int *presented_rate, int *presented_samples)
+{
+	initialize(rate, samples, presented_rate, presented_samples);
+}
+
+// ---------------------------------------------------------------- screen
+void OSD_BASE::set_vm_screen_size(int screen_width, int screen_height, int window_width, int window_height, int window_width_aspect, int window_height_aspect)
+{
+	if(window_width == -1) window_width = screen_width;
+	if(window_height == -1) window_height = screen_height;
+	if(window_width_aspect == -1) window_width_aspect = window_width;
+	if(window_height_aspect == -1) window_height_aspect = window_height;
+	if(vm_screen_width != screen_width || vm_screen_height != screen_height) {
+		vm_screen_width = screen_width;
+		vm_screen_height = screen_height;
+		screen_pixels.assign((size_t)screen_width * screen_height, 0xff000000);
+	}
+	vm_window_width = window_width;
+	vm_window_height = window_height;
+	vm_window_width_aspect = window_width_aspect;
+	vm_window_height_aspect = window_height_aspect;
+}
+
+scrntype_t *OSD_BASE::get_vm_screen_buffer(int y)
+{
+	if(y < 0 || y >= vm_screen_height) y = 0;
+	return &screen_pixels[(size_t)y * vm_screen_width];
+}
+
+int OSD_BASE::draw_screen()
+{
+	if(vm != NULL) {
+		vm->draw_screen();
+	}
+	return 1;
+}
+
+// ---------------------------------------------------------------- sound
+void OSD_BASE::update_sound(int *extra_frames)
+{
+	*extra_frames = 0;
+	sound_out_frames = 0;
+	if(vm == NULL) return;
+	uint16_t *buf = vm->create_sound(extra_frames);
+	if(buf != NULL) {
+		if((int)sound_out.size() < sound_samples * 2) sound_out.assign(sound_samples * 2, 0);
+		if(sound_muted) {
+			memset(&sound_out[0], 0, sound_samples * 2 * sizeof(int16_t));
+		} else {
+			memcpy(&sound_out[0], buf, sound_samples * 2 * sizeof(int16_t));
+		}
+		sound_out_frames = sound_samples;
+	}
+}
+
+// ---------------------------------------------------------------- input
+void OSD_BASE::key_down_native(int code, bool repeat)
+{
+	if(code < 0 || code > 255 || vm == NULL) return;
+	bool keep_frames = false;
+	if(code == 0xf0) {
+		code = VK_CAPITAL; keep_frames = true;
+	} else if(code == 0xf1 || code == 0xf2) {
+		code = VK_KANA; keep_frames = true;
+	} else if(code == 0xf3 || code == 0xf4) {
+		code = VK_KANJI; keep_frames = true;
+	}
+	if(key_status[code] == 0 || keep_frames) {
+		repeat = false;
+	}
+	key_status[code] = keep_frames ? KEY_KEEP_FRAMES : 0x80;
+
+	uint8_t prev_shift = key_status[VK_SHIFT];
+	uint8_t prev_control = key_status[VK_CONTROL];
+	uint8_t prev_menu = key_status[VK_MENU];
+	key_status[VK_SHIFT] = key_status[VK_LSHIFT] | key_status[VK_RSHIFT];
+	key_status[VK_CONTROL] = key_status[VK_LCONTROL] | key_status[VK_RCONTROL];
+	key_status[VK_MENU] = key_status[VK_LMENU] | key_status[VK_RMENU];
+
+	if(code == VK_LSHIFT || code == VK_RSHIFT) {
+		if(prev_shift == 0 && key_status[VK_SHIFT] != 0) vm->key_down(VK_SHIFT, repeat);
+	} else if(code == VK_LCONTROL || code == VK_RCONTROL) {
+		if(prev_control == 0 && key_status[VK_CONTROL] != 0) vm->key_down(VK_CONTROL, repeat);
+	} else if(code == VK_LMENU || code == VK_RMENU) {
+		if(prev_menu == 0 && key_status[VK_MENU] != 0) vm->key_down(VK_MENU, repeat);
+	}
+	vm->key_down(code, repeat);
+}
+
+void OSD_BASE::key_up_native(int code)
+{
+	if(code < 0 || code > 255 || vm == NULL) return;
+	if(key_status[code] == 0) return;
+	if((key_status[code] &= 0x7f) != 0) return;
+	vm->key_up(code);
+
+	uint8_t prev_shift = key_status[VK_SHIFT];
+	uint8_t prev_control = key_status[VK_CONTROL];
+	uint8_t prev_menu = key_status[VK_MENU];
+	key_status[VK_SHIFT] = key_status[VK_LSHIFT] | key_status[VK_RSHIFT];
+	key_status[VK_CONTROL] = key_status[VK_LCONTROL] | key_status[VK_RCONTROL];
+	key_status[VK_MENU] = key_status[VK_LMENU] | key_status[VK_RMENU];
+
+	if(code == VK_LSHIFT || code == VK_RSHIFT) {
+		if(prev_shift != 0 && key_status[VK_SHIFT] == 0) vm->key_up(VK_SHIFT);
+	} else if(code == VK_LCONTROL || code == VK_RCONTROL) {
+		if(prev_control != 0 && key_status[VK_CONTROL] == 0) vm->key_up(VK_CONTROL);
+	} else if(code == VK_LMENU || code == VK_RMENU) {
+		if(prev_menu != 0 && key_status[VK_MENU] == 0) vm->key_up(VK_MENU);
+	}
+}
+
+void OSD_BASE::update_input()
+{
+	// mouse: the VM wants the movement since the previous frame
+	mouse_status[0] = mouse_acc[0];
+	mouse_status[1] = mouse_acc[1];
+	mouse_acc[0] = mouse_acc[1] = 0;
+	// keys pressed with a "keep frames" count (kana/caps/kanji toggles) release themselves
+	for(int i = 0; i < 256; i++) {
+		if(key_status[i] & 0x7f) {
+			key_status[i] = (key_status[i] & 0x80) | ((key_status[i] & 0x7f) - 1);
+			if(key_status[i] == 0 && vm != NULL) vm->key_up(i);
+		}
+	}
+}
+
+void OSD_BASE::key_lost_focus()
+{
+	for(int i = 0; i < 256; i++) {
+		if(key_status[i] & 0x80) {
+			key_status[i] &= 0x7f;
+			if(key_status[i] == 0 && vm != NULL) vm->key_up(i);
+		}
+	}
+}
